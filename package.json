{
  "name": "lanturn-light",
  "version": "0.1.0",
  "description": "A buildable Green Lantern ring stack: Will → Brain → Constructs (drone swarm).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "example": "tsx examples/ring-mission.ts",
    "test": "tsx --test src/ring.test.ts"
  },
  "keywords": [
    "green-lantern",
    "ring",
    "bci",
    "emg",
    "drone-swarm",
    "constructs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
