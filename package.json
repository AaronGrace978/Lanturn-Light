{
  "name": "lanturn-light",
  "version": "0.1.0",
  "description": "Decision harness with outcome feedback — journal, reconcile, calibrate, reweight.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
