  },
  "keywords": [
    "decision-harness",
    "calibration",
    "trading",
    "agent",
    "feedback-loop"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
